{
  "name": "dsh-summary-command",
  "description": "Adds a /summary row to the composer's slash menu that asks the current session for a non-destructive, hand-off-ready conversation summary (OpenChamber-style magic prompt).",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "README.md", "locale/*.json", "icon.svg"],
  "keywords": ["dsh", "deepseek-harness", "dsh-plugin", "summary", "slash-command", "openchamber"],
  "license": "MIT",
  "dsh": {
    "engines": { "dsh": ">=0.2.2-rc.3" },
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-locale"]
    }
  }
}
